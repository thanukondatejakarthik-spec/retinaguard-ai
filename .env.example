# GEMINI_API_KEY: Required for Gemini AI multimodal retinal image analysis.
# Server-side only. AI Studio automatically injects this from user secrets.
# Users configure this via the Settings / Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=
